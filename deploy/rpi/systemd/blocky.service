[Unit]
Description=blocky — privacy DNS resolver + ad-blocker + noise machine
Documentation=https://github.com/HomeProjectsLab/blocky
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# One-time seed of the config DB from the boot-partition appliance.yml.
ExecStartPre=/bin/sh -c 'test -f /var/lib/blocky/config.db || /usr/local/bin/blocky import /boot/firmware/appliance.yml --db-dir /var/lib/blocky || /usr/local/bin/blocky import /boot/appliance.yml --db-dir /var/lib/blocky'
ExecStart=/usr/local/bin/blocky serve --db-dir /var/lib/blocky
Restart=always
RestartSec=2
# Bind privileged 53 + 80 without root.
DynamicUser=yes
StateDirectory=blocky
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
